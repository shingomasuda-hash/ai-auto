# 変数名のみ。値は各自の環境で設定する。値をリポジトリへコミットしない。

# --- データベース ---
DATABASE_URL=
DATABASE_POOL_MAX=
# 本番のマネージドDBでは require を指定する
DATABASE_SSL=

# --- アプリ ---
APP_BASE_URL=
# セッションCookieの署名に使う秘密値(32バイト以上)
SESSION_SECRET=
# 媒体トークンの暗号化キー(32バイトのbase64)
TOKEN_ENCRYPTION_KEY=

# --- Anthropic API ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Threads API ---
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=

# --- X API ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# --- メール配信 ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# テスト送信を許可する宛先(カンマ区切り)。ここにない宛先へは送らない。
EMAIL_ALLOWED_TEST_RECIPIENTS=

# --- ワーカー ---
WORKER_ID=
CRON_SECRET=
